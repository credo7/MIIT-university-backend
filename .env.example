# API Configuration
API_PORT=80

# MongoDB Configuration
MONGO_USERNAME=admin
MONGO_PASSWORD=your-secure-password-here
DATABASE_URL=mongodb://${MONGO_USERNAME}:${MONGO_PASSWORD}@mongodb:27017

# JWT Configuration
ACCESS_TOKEN_SECRET_KEY=your-secret-key-here-minimum-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=../app.log